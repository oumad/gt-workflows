# PostgreSQL — coffee-maker's own database
# 127.0.0.1, NOT "localhost": Windows resolves localhost to ::1 first, while
# the dockerised postgres (postgres-rdp.yml) only publishes on the IPv4
# loopback — localhost would connect slowly or not at all.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/coffee_maker

# Redis — production BullMQ instance (READ-ONLY)
# This is the existing production Redis, not managed by this stack
REDIS_URL=redis://user:password@host:6379
REDIS_BULLMQ_PREFIX=bull
REDIS_BULLMQ_QUEUE=workflow-studio-comfyui-process-queue
REDIS_LORA_QUEUE=lora-trainer-training-queue

# Sync interval in ms (default: 60000 = 1 min)
SYNC_INTERVAL_MS=60000

# App
PORT=3001
# Bind address. 0.0.0.0 (default) = every IPv4 interface, IPv4 ONLY — without
# it the server bound IPv6-only on Windows and 127.0.0.1 connections failed
# with ECONNREFUSED. Set HOST=:: only if you genuinely need dual-stack.
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Auth — JWT secret for signing local login tokens (REQUIRED, ≥ 16 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start in production if this is missing or set to the
# legacy dev fallback `dev-secret-change-in-production`.
JWT_SECRET=replace-with-a-random-64-char-hex-string

# Workflow data directory (relative or absolute). UNC paths work when the API
# runs natively, e.g. WORKFLOWS_DIR=\\fileserver\share\workflows — the process
# account must have access to the share (mind this if the API ever runs as a
# Windows service: LocalSystem has no network credentials).
WORKFLOWS_DIR=../workflows

# Server monitor
MONITOR_INTERVAL_MS=30000
MONITOR_TIMEOUT_MS=5000
MONITOR_STAGGER_MS=1000
# ComfyUI / AI-Toolkit probes go DIRECT by default even when HTTP_PROXY is set
# below — GPU hosts are internal and corporate proxies can't reach them, which
# used to mark every service "down" while ping looked fine. Flip to true only
# if your probe targets genuinely live behind the proxy.
MONITOR_USE_PROXY=false
# Log every probe (URL, duration, status / failure reason). Heavy with many
# servers — enable while debugging "shows down but I can reach it", then off.
MONITOR_VERBOSE=false

# Outbound HTTP proxy (optional)
# Standard env vars respected by all fetch() calls in the app (Discord, etc.).
# Health probes and RDP-bridge calls deliberately BYPASS this (see
# MONITOR_USE_PROXY above) — internal targets, the proxy can't reach them.
# HTTP_PROXY=http://proxy-host:3128
# HTTPS_PROXY=http://proxy-host:3128
# NO_PROXY=localhost,127.0.0.1,.internal   # comma-separated hostnames/suffixes to bypass

# RDP execution — a NATIVE Windows api MUST use the sidecar (xfreerdp/Xvfb
# are Linux-only). Bring it up with docker-compose-templates/postgres-rdp.yml
# and point at it (127.0.0.1, not localhost — see DATABASE_URL note):
# RDP_BRIDGE_URL=http://127.0.0.1:8080
# RDP_BRIDGE_TOKEN=   # openssl rand -hex 32 — must match the sidecar's token

# Discord webhooks (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
