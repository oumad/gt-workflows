# PostgreSQL — coffee-maker's own database
DATABASE_URL=postgresql://user:password@localhost:5432/coffee_maker

# Redis — production BullMQ instance (READ-ONLY)
# This is the existing production Redis, not managed by this stack
REDIS_URL=redis://user:password@host:6379
REDIS_BULLMQ_PREFIX=bull
REDIS_BULLMQ_QUEUE=workflow-studio-comfyui-process-queue
REDIS_LORA_QUEUE=lora-trainer-training-queue

# Sync interval in ms (default: 60000 = 1 min)
SYNC_INTERVAL_MS=60000

# App
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Auth — JWT secret for signing local login tokens (REQUIRED, ≥ 16 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start in production if this is missing or set to the
# legacy dev fallback `dev-secret-change-in-production`.
JWT_SECRET=replace-with-a-random-64-char-hex-string

# Workflow data directory (relative or absolute)
WORKFLOWS_DIR=../workflows

# Server monitor
MONITOR_INTERVAL_MS=30000
MONITOR_TIMEOUT_MS=5000
MONITOR_STAGGER_MS=1000

# Outbound HTTP proxy (optional)
# Standard env vars respected by all fetch() calls in the app (Discord, etc.)
# HTTP_PROXY=http://proxy-host:3128
# HTTPS_PROXY=http://proxy-host:3128
# NO_PROXY=localhost,127.0.0.1,.internal   # comma-separated hostnames/suffixes to bypass

# Discord webhooks (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
