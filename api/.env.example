# Env for a NATIVE api run (loaded from api/.env by dotenv). The docker
# templates set these on the container instead.

# Postgres connection (config) — prefer 127.0.0.1 over localhost on Windows
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/coffee_maker

# gt-workflows Redis, read-only job mirror (services/sync.ts)
REDIS_URL=redis://user:password@host:6379
# BullMQ key prefix + queue names to mirror — must match gt-workflows
REDIS_BULLMQ_PREFIX=bull
REDIS_BULLMQ_QUEUE=workflow-studio-comfyui-process-queue
REDIS_LORA_QUEUE=lora-trainer-training-queue

# Redis -> Postgres job sync interval, ms (services/sync.ts)
SYNC_INTERVAL_MS=60000

# HTTP listen port + bind address; 0.0.0.0 = all IPv4 interfaces (index.ts)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# debug = log every request; otherwise only failures + slow ones (requestLog)
LOG_LEVEL=info

# JWT signing key, >= 16 chars (auth) — openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-char-hex-string

# AES-256-GCM key for stored credentials (lib/crypto) — openssl rand -base64 32
# CREDENTIALS_MASTER_KEY=

# Workflow folders root; UNC paths work on a native run (lib/workflowFs)
WORKFLOWS_DIR=../workflows

# ── Git-managed workflows (off by default; lands phases dark) ──
# Master flag. While false, workflows stay pure-FS and the git vars below are
# ignored. Flip to true once the git phases are wired up.
GIT_WORKFLOWS_ENABLED=false
# Path to Workflow Studio's config file (holds workflowStudio.globalEnv).
# External to this repo, per-env.
# WS_CONFIG_PATH=/config/workflow-studio.json
# Scoped push token — injected into GIT_REMOTE at runtime, never written to
# .git/config. One token per scope.
# GIT_TOKEN=
# Tokenless remote URL; the token above is injected at runtime.
# GIT_REMOTE=https://host/group/workflows.git
# Branch model: agents/MCP pinned to the work branch, humans promote to default.
GIT_DEFAULT_BRANCH=main
GIT_WORK_BRANCH=test
# Optional staging branch for a 3-branch flow (test -> preprod -> main).
# GIT_STAGING_BRANCH=preprod

# Health monitor (services/serverHealth.ts): cadence / timeout / boot delay, ms
MONITOR_INTERVAL_MS=30000
MONITOR_TIMEOUT_MS=5000
MONITOR_STAGGER_MS=1000
# Anti-flicker: retry a failed probe N times in-round before marking down (0 off)
MONITOR_RETRIES=1
# Max probes in flight at once — caps the per-round load spike
MONITOR_CONCURRENCY=8
# Consecutive failed ROUNDS before a record shows/alerts down (hysteresis)
MONITOR_DOWN_AFTER=2
# true = ComfyUI/AI-Toolkit traffic (probes, logs, actions, tests) uses HTTP_PROXY
MONITOR_USE_PROXY=false
# true = log every probe with target/duration/result (debugging only)
MONITOR_VERBOSE=false

# Timeout for ComfyUI/AI-Toolkit calls other than probes, ms (lib/comfy.ts)
COMFY_TIMEOUT_MS=5000

# Extra xfreerdp args for the RDP credential probe (services/rdp.ts) — escape
# hatch for unusual hosts, applied without a rebuild (change + restart). Empty
# by default: the FreeRDP 2 image works out of the box. Use FreeRDP-2 syntax if
# you add any (e.g. /tls-seclevel:0).
RDP_EXTRA_ARGS=

# Outbound proxy for INTERNET calls only (Discord); GPU traffic skips it
# HTTP_PROXY=http://proxy-host:3128
# HTTPS_PROXY=http://proxy-host:3128
# NO_PROXY=localhost,127.0.0.1,.internal

# Discord alerts webhook (lib/discord.ts)
# DISCORD_WEBHOOK_URL=
