# Copy to .env and fill in real values before running docker compose.
#
# docker-compose-templates/prod.yml refuses to start without JWT_SECRET and
# CREDENTIALS_MASTER_KEY (the `${VAR:?...}` syntax fails fast). The other
# variables have sane defaults for local-dev experimentation but should be
# overridden on any non-laptop deploy.

# ── REQUIRED in prod ──────────────────────────────────────────

# JWT signing key. 64-char hex (32 bytes). Rotate this when ops handover.
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-char-hex-string

# AES-256-GCM master key for credentials/secrets at rest. 32 bytes base64.
# Rotation is non-trivial: re-encrypts every row in the credentials table.
#   openssl rand -base64 32
CREDENTIALS_MASTER_KEY=replace-with-a-32-byte-base64-key

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

# ── Redis queue (must match the gt-workflows producer) ────────
REDIS_BULLMQ_PREFIX=bull
REDIS_BULLMQ_QUEUE=workflow-studio-comfyui-process-queue
REDIS_LORA_QUEUE=lora-trainer-training-queue

# ── Networking ────────────────────────────────────────────────
# Public port the frontend listens on. Bind to 80 directly only when no
# other reverse proxy is in front. With Caddy / nginx terminating TLS use
# 8080 (or similar) and proxy to it.
FRONTEND_PORT=80

# CORS origin for direct API consumers (CI scripts, MCP clients). The
# browser doesn't need this in prod because the frontend's nginx proxies
# /api, making everything same-origin. "*" is permissive — tighten when
# you have a public hostname.
CORS_ORIGIN=*

# ── Integrations ──────────────────────────────────────────────
# Discord webhook for alerts and reminders. NEVER COMMIT a real URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Filesystem ────────────────────────────────────────────────
# Host path bind-mounted into the API container as /workflows. Workflow
# folders + their .history snapshots live here. Back this up.
WORKFLOWS_DIR=./workflows

# Health monitoring (all in milliseconds, all optional).
# MONITOR_INTERVAL_MS: how often the API probes servers (ICMP ping) and
#   services (ComfyUI / AI-Toolkit HTTP reachability) for up/down status.
# MONITOR_TIMEOUT_MS:  overall per-probe timeout budget.
# MONITOR_STAGGER_MS:  delay before the first probe after boot.
MONITOR_INTERVAL_MS=30000
MONITOR_TIMEOUT_MS=5000
MONITOR_STAGGER_MS=1000
# MONITOR_USE_PROXY: when true, ComfyUI/AI-Toolkit probes go through the
# global HTTP_PROXY (if set). Default false — internal GPU servers usually
# aren't in operator NO_PROXY lists and would erroneously route through the
# corporate proxy, failing the probe. Flip to true only if your probe targets
# genuinely live behind the corporate proxy.
MONITOR_USE_PROXY=false
# MONITOR_VERBOSE: log every probe (URL, duration, status / failure reason).
# Heavy with many monitored servers — enable only while debugging.
MONITOR_VERBOSE=false

# ── RDP execution ────────────────────────────────────────────
# Embedded mode (default): leave both unset. The api image bundles freerdp +
# Xvfb and spawns them directly when a user clicks "RDP In".
# Sidecar mode: point at the rdp-sidecar container (see rdp-sidecar/ and
# docker-compose-templates/postgres-rdp.yml). Keeps the api image slim and
# is the only option when running the api natively on Windows.
# RDP_BRIDGE_URL=http://rdp-sidecar:8080
# RDP_BRIDGE_TOKEN= # openssl rand -hex 32 — must match the sidecar's token
