# Copy to .env (read by docker compose from the repo root). prod.yml and
# standalone.yml refuse to start without JWT_SECRET + CREDENTIALS_MASTER_KEY;
# everything else has dev-safe defaults.

# JWT signing key for API auth (api) — openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-char-hex-string

# AES-256-GCM key for credentials at rest (api) — openssl rand -base64 32
CREDENTIALS_MASTER_KEY=replace-with-a-32-byte-base64-key

# Postgres container credentials; also baked into the api's DATABASE_URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

# BullMQ queues the api mirrors from Redis — must match gt-workflows
REDIS_BULLMQ_PREFIX=bull
REDIS_BULLMQ_QUEUE=workflow-studio-comfyui-process-queue
REDIS_LORA_QUEUE=lora-trainer-training-queue

# Host port the frontend container publishes (prod.yml / standalone.yml)
FRONTEND_PORT=80

# Allowed origins for direct API consumers, comma-separated (api CORS)
CORS_ORIGIN=*

# Discord webhook for server alerts (api) — never commit a real URL
# DISCORD_WEBHOOK_URL=

# Host folder bind-mounted as /workflows in the api container
WORKFLOWS_DIR=./workflows

# Health monitor (api): probe interval / per-probe timeout / boot delay, ms
MONITOR_INTERVAL_MS=30000
MONITOR_TIMEOUT_MS=5000
MONITOR_STAGGER_MS=1000
# true = ComfyUI/AI-Toolkit traffic (probes, logs, actions) uses HTTP_PROXY
MONITOR_USE_PROXY=false
# true = log every probe with target/duration/result (debugging only)
MONITOR_VERBOSE=false

# RDP sidecar (postgres-rdp.yml). Unset = the api image runs xfreerdp itself.
# RDP_BRIDGE_URL=http://rdp-sidecar:8080
# RDP_BRIDGE_TOKEN=   # openssl rand -hex 32 — same value on both sides
